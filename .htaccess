# Apache .htaccess Configuration for Appliance Repair Knights
# SEO-Friendly Clean URLs & Sitemap Configuration

# Custom 404 Error Page
ErrorDocument 404 /404.php

# XML Sitemap Header & Directive
# Sitemap: https://www.appliancerepairknights.com/sitemap.xml

<IfModule mod_rewrite.c>
  RewriteEngine On

  # -------------------------------------------------------------
  # CANONICAL DOMAIN & HTTPS REDIRECT (NON-WWW TO WWW 301 ON PRODUCTION)
  # -------------------------------------------------------------
  # 1. Force HTTPS on Production
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?appliancerepairknights\.(com|ca)$ [NC]
  RewriteRule ^(.*)$ https://www.appliancerepairknights.com/$1 [R=301,L]

  # 2. Redirect .ca or non-www to https://www.appliancerepairknights.com
  RewriteCond %{HTTP_HOST} ^appliancerepairknights\.ca$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^appliancerepairknights\.com$ [NC]
  RewriteRule ^(.*)$ https://www.appliancerepairknights.com/$1 [R=301,L]

  # Route sitemap.xml to dynamic sitemap.php (auto filemtime & 304 caching)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^404\.php$ - [L]

  # -------------------------------------------------------------
  # 301 REDIRECTS (OLD WIX URLS TO NEW STRUCTURE)
  # -------------------------------------------------------------

  # 1. Location Pages 301 Redirects
  RewriteRule ^burlington-appliance-repair/?$ locations/burlington-appliance-repair [R=301,L]
  RewriteRule ^kitchener-appliance-repair/?$ locations/kitchener-appliance-repair [R=301,L]
  RewriteRule ^brampton-appliance-repair/?$ locations/brampton-appliance-repair [R=301,L]
  RewriteRule ^waterloo-appliance-repair/?$ locations/waterloo-appliance-repair [R=301,L]
  RewriteRule ^cambridge-appliance-repair/?$ locations/cambridge-appliance-repair [R=301,L]
  RewriteRule ^hamilton-appliance-repair/?$ locations/hamilton-appliance-repair [R=301,L]
  RewriteRule ^caledon-appliance-repair/?$ locations/caledon-appliance-repair [R=301,L]
  RewriteRule ^caledeon-appliance-repair/?$ locations/caledon-appliance-repair [R=301,L]
  RewriteRule ^caldeon-appliance-repair/?$ locations/caledon-appliance-repair [R=301,L]
  RewriteRule ^locations/caldeon-appliance-repair/?$ locations/caledon-appliance-repair [R=301,L]
  RewriteRule ^locations/caledeon-appliance-repair/?$ locations/caledon-appliance-repair [R=301,L]
  RewriteRule ^pickering-appliance-repair/?$ locations/pickering-appliance-repair [R=301,L]
  RewriteRule ^vaughan-appliance-repair/?$ locations/vaughan-appliance-repair [R=301,L]
  RewriteRule ^richmond-hill-appliance-repair/?$ locations/richmond-hill-appliance-repair [R=301,L]
  RewriteRule ^mississauga-appliance-repair/?$ locations/mississauga-appliance-repair [R=301,L]
  RewriteRule ^toronto-appliance-repair/?$ locations/toronto-appliance-repair [R=301,L]
  RewriteRule ^guelph-appliance-repair/?$ locations/guelph-appliance-repair [R=301,L]
  RewriteRule ^markham-appliance-repair/?$ locations/markham-appliance-repair [R=301,L]
  RewriteRule ^oakville-appliance-repair/?$ locations/oakville-appliance-repair [R=301,L]
  RewriteRule ^scarborough-appliance-repair/?$ locations/scarborough-appliance-repair [R=301,L]
  RewriteRule ^oshawa-appliance-repair/?$ locations/oshawa-appliance-repair [R=301,L]
  RewriteRule ^milton-appliance-repair/?$ locations/milton-appliance-repair [R=301,L]
  RewriteRule ^barrie-appliance-repair/?$ locations/barrie-appliance-repair [R=301,L]
  RewriteRule ^ajax-appliance-repair/?$ locations/ajax-appliance-repair [R=301,L]

  # 2. Service Pages Redirects
  RewriteRule ^refrigerator-repair/?$ services/fridge-repair [R=301,L]
  RewriteRule ^service-page/?$ services/stove-repair [R=301,L]
  RewriteRule ^service-page/microwave-repair-and-installation/?$ services/microwave-repair [R=301,L]
  RewriteRule ^service-page/dryer-repair-duct-cleaning/?$ services/dryer-repair [R=301,L]
  RewriteRule ^induction-cooktop-repair-service/?$ services/stove-repair [R=301,L]
  RewriteRule ^oven-repair-service/?$ services/stove-repair [R=301,L]

  # Redirect /index or /index.php to Root Domain (/)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.php)?\ HTTP/ [NC]
  RewriteRule ^index(\.php)?$ ./ [R=301,L]

  # -------------------------------------------------------------
  # DYNAMIC LOCATION ROUTER
  # -------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^locations/([a-z0-9\-]+)/?$ locations/location.php?slug=$1 [L,QSA]

  # -------------------------------------------------------------
  # CLEAN URL ENGINE (.PHP REMOVAL & ROUTING)
  # -------------------------------------------------------------

  # 1. Redirect GET requests with .php extension to clean URL (301 Permanent Redirect for SEO)
  # Do NOT redirect POST requests, send-lead.php, or 404.php
  RewriteCond %{REQUEST_METHOD} !=POST
  RewriteCond %{THE_REQUEST} !/send-lead\.php [NC]
  RewriteCond %{THE_REQUEST} !/404\.php [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 2. Remove trailing slashes from URLs (unless directory)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # 3. Internally route clean extensionless URL to corresponding .php file if it exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)$ $1.php [L]
</IfModule>

# Disable directory listing for security & speed
Options -Indexes

# Serve XML Sitemaps with Correct Content-Type Header
<IfModule mod_headers.c>
  <FilesMatch "sitemap\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
  </FilesMatch>
</IfModule>

# ==============================================================================
# 1. GZIP / DEFLATE COMPRESSION ENGINE
# ==============================================================================
<IfModule mod_deflate.c>
  # Force compression for mangled headers
  <IfModule mod_setenvif.c>
    <IfModule mod_headers.c>
      SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
      RequestHeader append Accept-Encoding "gzip,deflate" env=HAVE_Accept-Encoding
    </IfModule>
  </IfModule>

  # Compress all relevant text, script, font, and data formats
  AddOutputFilterByType DEFLATE text/html \
                                text/plain \
                                text/xml \
                                text/css \
                                text/javascript \
                                application/xml \
                                application/xhtml+xml \
                                application/rss+xml \
                                application/javascript \
                                application/x-javascript \
                                application/json \
                                application/ld+json \
                                application/manifest+json \
                                application/vnd.ms-fontobject \
                                application/x-font-ttf \
                                font/ttf \
                                font/otf \
                                font/opentype \
                                font/woff \
                                font/woff2 \
                                image/svg+xml \
                                image/x-icon
</IfModule>

# ==============================================================================
# 2. BROWSER CACHING (EXPIRES HEADERS)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Media (1 Year)
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # Web Fonts (1 Year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # CSS & JavaScript (1 Year with cache busting / 1 Month)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Manifest & Structured Data
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/ld+json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ==============================================================================
# 3. HTTP CACHE-CONTROL & PERFORMANCE HEADERS
# ==============================================================================
<IfModule mod_headers.c>
  # 1-Year Immutable Caching for Static Assets
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|avif|swf|svg|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
    Header unset ETag
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=31536000, public"
    Header unset ETag
  </FilesMatch>

  # Prevent intermediate proxy caching mismatches
  Header append Vary "Accept-Encoding"

  # Dynamic HTML / PHP Caching Policy (Allows 304 Revalidation & Fast History Navigation)
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>

  # -------------------------------------------------------------
  # 4. MODERN HTTP SECURITY HEADERS
  # -------------------------------------------------------------
  # Enforce HTTPS with HSTS (1 Year, includes subdomains)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Prevent clickjacking / frame embedding
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Control referrer info passed to third parties
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict sensitive device APIs
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

  # Remove server technology disclosure headers
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# Disable ETags to reduce HTTP header size & eliminate redundant round-trips
FileETag None

