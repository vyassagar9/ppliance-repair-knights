# ==============================================================================
# Apache / LiteSpeed .htaccess Configuration
# Appliance Repair Knights Ltd. (https://www.appliancerepairknights.com)
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Custom 404 Error Page (Pre-rendered static HTML for zero CPU / PHP overhead)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase is intentionally omitted so rules work seamlessly both
  # in local subdirectory environments (e.g. /canada/) and on production domain root.
  # RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. UNIFIED CANONICAL DOMAIN & HTTPS REDIRECT (SINGLE 301 HOP)
  # Redirects HTTP, non-www, and .ca variations to https://www.appliancerepairknights.com
  # Handles Hostinger / LiteSpeed reverse proxy SSL (X-Forwarded-Proto)
  # Safe for local MAMP development (checks domain explicitly)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^(www\.)?appliancerepairknights\.(com|ca)$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP_HOST} !^www\.appliancerepairknights\.com$ [NC]
  RewriteRule ^(.*)$ https://www.appliancerepairknights.com/$1 [R=301,L,NE]

  # ----------------------------------------------------------------------------
  # 2. CORE SITEMAP & SYSTEM EXCEPTIONS
  # ----------------------------------------------------------------------------
  # Redirect direct visits to sitemap.php -> canonical sitemap.xml
  RewriteCond %{THE_REQUEST} \s/+sitemap\.php[\s?] [NC]
  RewriteRule ^ sitemap.xml [R=301,L]

  # Route sitemap.xml to dynamic sitemap.php
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Pass static files and error pages directly
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^404\.html$ - [L]
  RewriteRule ^404\.php$ - [L]

  # ----------------------------------------------------------------------------
  # 3. 301 REDIRECTS (OLD / LEGACY URLS TO NEW CANONICAL STRUCTURE)
  # ----------------------------------------------------------------------------
  # Typo aliases for Caledon
  RewriteCond %{REQUEST_URI} ^(.*?)/locations/cal(e)?deon-appliance-repair/?$ [NC]
  RewriteRule ^ %1/locations/caledon-appliance-repair [R=301,L]

  # Location Pages (e.g. /burlington-appliance-repair -> /locations/burlington-appliance-repair)
  RewriteCond %{REQUEST_URI} !/locations/ [NC]
  RewriteCond %{REQUEST_URI} ^(.*?)/(burlington|kitchener|brampton|waterloo|cambridge|hamilton|caledon|caledeon|caldeon|pickering|vaughan|richmond-hill|mississauga|toronto|guelph|markham|oakville|scarborough|oshawa|milton|barrie|ajax)-appliance-repair/?$ [NC]
  RewriteRule ^ %1/locations/%2-appliance-repair [R=301,L]

  # Service Pages
  RewriteCond %{REQUEST_URI} !/services/ [NC]
  RewriteCond %{REQUEST_URI} ^(.*?)/refrigerator-repair/?$ [NC]
  RewriteRule ^ %1/services/fridge-repair [R=301,L]

  RewriteCond %{REQUEST_URI} !/services/ [NC]
  RewriteCond %{REQUEST_URI} ^(.*?)/service-page/microwave-repair-and-installation/?$ [NC]
  RewriteRule ^ %1/services/microwave-repair [R=301,L]

  RewriteCond %{REQUEST_URI} !/services/ [NC]
  RewriteCond %{REQUEST_URI} ^(.*?)/service-page/dryer-repair-duct-cleaning/?$ [NC]
  RewriteRule ^ %1/services/dryer-repair [R=301,L]

  RewriteCond %{REQUEST_URI} !/services/ [NC]
  RewriteCond %{REQUEST_URI} ^(.*?)/(service-page|induction-cooktop-repair-service|oven-repair-service)/?$ [NC]
  RewriteRule ^ %1/services/stove-repair [R=301,L]

  # Redirect /index, /index.html or /index.php to root (/)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.(html|php))?\ HTTP/ [NC]
  RewriteRule ^index(\.(html|php))?$ ./ [R=301,L]

  # ----------------------------------------------------------------------------
  # 4. DYNAMIC LOCATION ROUTER
  # ----------------------------------------------------------------------------
  RewriteRule ^locations/?$ locations/index.php [L,QSA]
  RewriteRule ^locations/index(\.php)?/?$ locations/index.php [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^locations/([a-z0-9\-]+)(\.php)?/?$ locations/location.php?slug=$1 [L,QSA]

  # ----------------------------------------------------------------------------
  # 4B. DYNAMIC BLOG ROUTER
  # ----------------------------------------------------------------------------
  RewriteRule ^blog/?$ blog/index.php [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog/([a-z0-9\-]+)/?$ blog/post.php?slug=$1 [L,QSA]

  # ----------------------------------------------------------------------------
  # 5. CLEAN URL ENGINE (.PHP / .HTML STRIPPING & INTERNAL ROUTING)
  # ----------------------------------------------------------------------------
  # Remove trailing slashes from URLs (unless directory)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/+$
  RewriteRule ^ %1 [R=301,L,NE]

  # Strip .php extension on external GET requests (preserve send-lead & sitemap)
  RewriteCond %{REQUEST_METHOD} !=POST
  RewriteCond %{THE_REQUEST} !/send-lead\.php [NC]
  RewriteCond %{THE_REQUEST} !/sitemap\.php [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Internal rewrite for extensionless URLs -> .php or .html files
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)$ $1.php [L]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)$ $1.html [L]
</IfModule>

# ==============================================================================
# 6. SITEMAP XML CONTENT-TYPE
# ==============================================================================
<IfModule mod_headers.c>
  <FilesMatch "sitemap\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
  </FilesMatch>
</IfModule>

# ==============================================================================
# 7. GZIP / DEFLATE COMPRESSION ENGINE
# ==============================================================================
<IfModule mod_deflate.c>
  # Force compression for mangled headers
  <IfModule mod_setenvif.c>
    <IfModule mod_headers.c>
      SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
      RequestHeader append Accept-Encoding "gzip,deflate" env=HAVE_Accept-Encoding
    </IfModule>
  </IfModule>

  # Compress all relevant text, script, font, and data formats
  AddOutputFilterByType DEFLATE text/html \
                                text/plain \
                                text/xml \
                                text/css \
                                text/javascript \
                                application/xml \
                                application/xhtml+xml \
                                application/rss+xml \
                                application/javascript \
                                application/x-javascript \
                                application/json \
                                application/ld+json \
                                application/manifest+json \
                                application/vnd.ms-fontobject \
                                application/x-font-ttf \
                                font/ttf \
                                font/otf \
                                font/opentype \
                                font/woff \
                                font/woff2 \
                                image/svg+xml \
                                image/x-icon
</IfModule>

# ==============================================================================
# 8. BROWSER CACHING (EXPIRES HEADERS)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Media (1 Year)
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # Web Fonts (1 Year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # CSS & JavaScript (1 Year)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # HTML & Structured Data (Short cache with revalidation)
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/ld+json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ==============================================================================
# 9. HTTP CACHE-CONTROL & SECURITY HEADERS
# ==============================================================================
<IfModule mod_headers.c>
  # 1-Year Immutable Caching for Static Assets
  <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|avif|svg|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
    Header unset ETag
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=31536000, public"
    Header unset ETag
  </FilesMatch>

  # HTML & Dynamic Pages (Allows 304 Revalidation without stale caching)
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>

  Header append Vary "Accept-Encoding"

  # Security Headers (Applied directly without env=HTTPS for LiteSpeed reverse proxy compatibility)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

  # Remove server disclosure
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# Disable ETags
FileETag None
